# AI Bill & Expense Analyzer Environment Configuration

# Application Settings
APP_ENV=development
APP_CURRENCY=₹
DEFAULT_MODEL_PROVIDER=local_flan  # Options: local_flan, local_grounded, gemini, openai

# Optional: Google Gemini API (for advanced cloud-based LLM inference)
GEMINI_API_KEY=

# Optional: OpenAI API Key (for alternative cloud-based LLM inference)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Path (defaults to data/expenses.db)
DATABASE_URL=sqlite:///data/expenses.db

# OCR Configuration
TESSERACT_CMD=  # e.g., C:\Program Files\Tesseract-OCR\tesseract.exe (optional if in PATH)
